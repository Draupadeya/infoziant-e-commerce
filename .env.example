# ==============================================================================
# SECRID STOREFRONT - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL Credentials (PRIVATE - Internal Docker Network only)
POSTGRES_USER=shopuser
POSTGRES_PASSWORD=SecridStrongDbPassword2026!
POSTGRES_DB=shopdb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# FastAPI Database Connection URL (Internal Docker Bridge)
DATABASE_URL=postgresql://shopuser:SecridStrongDbPassword2026!@db:5432/shopdb

# Application Settings
ENVIRONMENT=production
SECRET_KEY=change_this_to_a_random_secure_hex_token_in_production
ALLOWED_HOSTS=*

# Port Configuration
# Publicly accessible gateway port
HTTP_PORT=80
HTTPS_PORT=443

# Internal Container Ports (NEVER expose to public host 0.0.0.0)
FASTAPI_INTERNAL_PORT=8000
POSTGRES_INTERNAL_PORT=5432
FRONTEND_INTERNAL_PORT=80
